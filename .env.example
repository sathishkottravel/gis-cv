# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# PostGIS (docker compose service "db", published on host port 5433)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=signs
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/signs

# S3-compatible object storage (docker compose service "storage", RustFS)
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=change-me-storage
STORAGE_ENDPOINT=localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000

# GitHub OAuth App (callback: http://localhost:8000/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string used to sign the session cookie
SESSION_SECRET=change-me-session-secret

# Dev API key for scripts and Swagger uploads (leave empty to disable)
API_KEY=change-me-api-key
